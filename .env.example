# Copy to .env and fill in. Never commit .env.
# Assignment A calculators + CLI need NO keys and run fully offline.
# Keys are only needed for the LLM-phrased assistant (A) and image generation (B).

# --- Assignment A: LLM (only for the natural-language assistant layer) ---
ANTHROPIC_API_KEY=
# Model used to parse intent + phrase answers (numbers still come from code).
KNIT_LLM_MODEL=claude-haiku-4-5-20251001

# --- Assignment B: image generation ---
OPENAI_API_KEY=

# --- Assignment B: Ravelry reference lookup (free developer account) ---
RAVELRY_USERNAME=
RAVELRY_PASSWORD=
